generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PARENT
  CHILD
}

enum EpisodeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  INCOMPLETE
}

enum XpSource {
  EPISODE_COMPLETED
  QUIZ_COMPLETED
  QUIZ_PERFECT
  DAILY_STREAK
  ACHIEVEMENT
  BONUS
  MANUAL_ADJUSTMENT
}

enum VideoType {
  PERSONALIZADO
  HOMENAGEM
}

enum VideoStatus {
  DRAFT
  PROCESSING
  GENERATING_IMAGES
  GENERATING_AUDIO
  GENERATING_VIDEO
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId         String             @unique @db.Uuid
  role               UserRole
  displayName        String
  email              String?            @unique
  avatarUrl          String?
  locale             String             @default("pt-BR")
  birthDate          DateTime?          @db.Date
  parentId           String?            @db.Uuid
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  parent             User?              @relation("FamilyMembers", fields: [parentId], references: [id], onDelete: Cascade)
  children           User[]             @relation("FamilyMembers")
  progress           LearningProgress[]
  quizAttempts       QuizAttempt[]
  achievements       UserAchievement[]
  xpTransactions     XpTransaction[]
  subscriptions      Subscription[]
  videoProjects      VideoProject[]
  personalizedEpisodes PersonalizedEpisode[]
  listeningStats       ListeningStats[]

  @@index([parentId])
  @@index([role])
  @@map("users")
}

model VideoProject {
  id                    String      @id @default(cuid())
  userId                String      @db.Uuid
  type                  VideoType
  title                 String
  description           String
  duration              Int
  status                VideoStatus @default(DRAFT)
  protagonistName       String
  protagonistAge        Int?
  protagonistGender     String?
  protagonistPhotoUrl   String?
  tributeType           String?
  tributeTarget         String?
  tributeRelation       String?
  customMessage         String?
  imageRightsConsent    Boolean     @default(false)
  consentDate           DateTime?
  audioScript           String?
  audioUrl              String?
  videoUrl              String?
  thumbnailUrl          String?
  videoDuration         Int?
  isPaid                Boolean     @default(false)
  paymentId             String?
  paymentAmount         Float?
  prompt                String?
  style                 String      @default("infantil_colorido")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  user                  User        @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Season {
  id           String              @id @default(cuid())
  seasonNumber Int                 @unique
  status       ContentStatus       @default(DRAFT)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  translations SeasonTranslation[]
  episodes     Episode[]

  @@map("seasons")
}

model SeasonTranslation {
  id          String   @id @default(cuid())
  seasonId    String
  locale      String
  title       String
  subtitle    String?
  description String?
  themeColor  String?
  visualTheme String?
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, locale])
  @@index([locale])
  @@map("season_translations")
}

model Episode {
  id                 String              @id @default(cuid())
  seasonId           String?
  episodeNumber      Int
  status             EpisodeStatus       @default(DRAFT)
  durationSeconds    Int?
  coverImageUrl      String?
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  seasonObj          Season?             @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  translations       EpisodeTranslation[]
  audioAssets        AudioAsset[]
  progress           LearningProgress[]
  quiz               Quiz?
  characters         EpisodeCharacter[]

  // Novos campos para catálogo
  title           String?
  description     String?
  audioUrl        String?
  duration        Int?
  ageRange        String?
  character       String?
  season          String?
  coverColor      String?
  isReady         Boolean  @default(false)
  isPremium       Boolean  @default(false)
  playCount       Int      @default(0)
  totalListenTime Int      @default(0) // em segundos
  averageRating   Float?
  tags            String[] // ["aventura", "coragem", "fé"]
  thumbnailUrl    String?

  personalizedEpisodes PersonalizedEpisode[]
  listeningStats       ListeningStats[]

  @@index([status])
  @@index([character, ageRange])
  @@index([isReady, season])
  @@map("episodes")
}

model EpisodeTranslation {
  id            String  @id @default(cuid())
  episodeId     String
  locale        String
  title         String
  subtitle      String?
  description   String?
  moralLesson   String?
  biblicalRef   String?
  category      String?
  tags          Json?
  episode       Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, locale])
  @@index([locale])
  @@map("episode_translations")
}

model AudioAsset {
  id          String   @id @default(cuid())
  episodeId   String
  locale      String
  storagePath String
  publicUrl   String?
  durationSec Int?
  mimeType    String   @default("audio/mpeg")
  bitrate     Int?
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, locale])
  @@map("audio_assets")
}

model Character {
  id           String                 @id @default(cuid())
  slug         String                 @unique
  imageUrl     String?
  characterType String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  translations CharacterTranslation[]
  episodes     EpisodeCharacter[]

  @@map("characters")
}

model CharacterTranslation {
  id          String    @id @default(cuid())
  characterId String
  locale      String
  name        String
  description String?
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, locale])
  @@index([locale])
  @@map("character_translations")
}

model EpisodeCharacter {
  episodeId   String
  characterId String
  isFeatured  Boolean   @default(false)
  episode     Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([episodeId, characterId])
  @@map("episode_characters")
}

model LearningProgress {
  id                String         @id @default(cuid())
  userId            String         @db.Uuid
  episodeId         String
  status            ProgressStatus  @default(NOT_STARTED)
  progressPercent   Int            @default(0)
  lastPositionSec   Int            @default(0)
  completedAt       DateTime?
  lastPlayedAt      DateTime?
  playCount         Int            @default(0)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode           Episode         @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, status])
  @@map("learning_progress")
}

model Achievement {
  id                 String             @id @default(cuid())
  slug               String             @unique
  icon               String?
  xpReward           Int                @default(0)
  requirement        Json
  translations       AchievementTranslation[]
  users              UserAchievement[]

  @@map("achievements")
}

model AchievementTranslation {
  id            String      @id @default(cuid())
  achievementId String
  locale        String
  name          String
  description   String?
  achievement   Achievement  @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([achievementId, locale])
  @@map("achievement_translations")
}

model UserAchievement {
  userId        String      @db.Uuid
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement  Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

model XpTransaction {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  amount      Int
  source      XpSource
  referenceId String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("xp_transactions")
}

model SubscriptionPlan {
  id             String               @id @default(cuid())
  slug           String               @unique
  interval       SubscriptionInterval
  priceCents     Int
  currency       String               @default("BRL")
  trialDays      Int                  @default(0)
  features       Json?
  active         Boolean              @default(true)
  translations   SubscriptionPlanTranslation[]
  subscriptions  Subscription[]

  @@map("subscription_plans")
}

model SubscriptionPlanTranslation {
  id          String           @id @default(cuid())
  planId      String
  locale      String
  name        String
  description String?
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, locale])
  @@map("subscription_plan_translations")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @db.Uuid
  planId               String
  status               SubscriptionStatus @default(INCOMPLETE)
  provider             String             @default("stripe")
  providerCustomerId   String?
  providerSubscriptionId String?          @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([providerCustomerId])
  @@map("subscriptions")
}

model Quiz {
  id           String         @id @default(cuid())
  episodeId    String         @unique
  passingScore Int            @default(70)
  xpReward     Int            @default(25)
  published    Boolean        @default(false)
  episode      Episode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  translations QuizTranslation[]
  questions    QuizQuestion[]
  attempts     QuizAttempt[]

  @@map("quizzes")
}

model QuizTranslation {
  id          String   @id @default(cuid())
  quizId      String
  locale      String
  title       String
  description String?
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, locale])
  @@map("quiz_translations")
}

model QuizQuestion {
  id           String                        @id @default(cuid())
  quizId       String
  position     Int
  correctIndex Int
  explanation  String?
  biblicalRef  String?
  quiz         Quiz                          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  translations QuizQuestionTranslation[]
  answers      QuizAnswer[]

  @@unique([quizId, position])
  @@map("quiz_questions")
}

model QuizQuestionTranslation {
  id         String       @id @default(cuid())
  questionId String
  locale     String
  question   String
  options    Json
  questionRef QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, locale])
  @@map("quiz_question_translations")
}

model QuizAttempt {
  id          String       @id @default(cuid())
  userId      String       @db.Uuid
  quizId      String
  score       Int
  correct     Int
  total       Int
  completedAt DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([userId, completedAt])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id         String       @id @default(cuid())
  attemptId  String
  questionId String
  answerIndex Int
  isCorrect  Boolean
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("quiz_answers")
}

// Adicionar model para personalizações
model PersonalizedEpisode {
  id              String   @id @default(cuid())
  userId          String   @db.Uuid
  episodeId       String
  childName       String
  childAge        Int?
  customAudioUrl  String
  baseEpisodeId   String   // referência ao episódio original
  status          String   @default("processing") // processing, ready, failed
  createdAt       DateTime @default(now())
  
  user            User     @relation(fields: [userId], references: [id])
  baseEpisode     Episode  @relation(fields: [baseEpisodeId], references: [id])
  
  @@index([userId, createdAt])
}

// Adicionar model para métricas
model ListeningStats {
  id              String   @id @default(cuid())
  userId          String   @db.Uuid
  episodeId       String
  listenDate      DateTime @default(now())
  listenDuration  Int      // segundos ouvidos
  completed       Boolean  @default(false)
  device          String?  // mobile, desktop, tablet
  
  user            User     @relation(fields: [userId], references: [id])
  episode         Episode  @relation(fields: [episodeId], references: [id])

  @@index([userId, listenDate])
}
